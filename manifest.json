{
  "manifest_version": 3,
  "name": "HAPP Browser",
  "version": "0.3.0",
  "description": "Диагностика VPN-подключения и сетевых утечек в Firefox.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ipwho.is/*",
    "https://dnsleak.dev/*",
    "https://*.t.dnsleak.dev/*"
  ],
  "action": {
    "default_title": "HAPP Browser",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "happ-browser@slimgt-ui",
      "strict_min_version": "109.0"
    }
  }
}
